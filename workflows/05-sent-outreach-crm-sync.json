      "name": "Read Outreach Drafts"
    },
    {
      "parameters": {
        "jsCode": "const normalize = value =>\n  String(value || '').trim().toLowerCase();\n\nreturn $input.all().filter(item => {\n  const row = item.json;\n  const campaignId = normalize(row.campaign_id);\n  const draftStatus = normalize(row.draft_status);\n  const notes = normalize(row.notes);\n\n  return (\n    campaignId.startsWith('example_outreach') &&\n    draftStatus === 'sent' &&\n    !notes.includes('crm synced')\n  );\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -192,
        224
      ],
      "id": "d77ca208-35b8-5647-8f2d-da3f438f6775",
      "name": "Select Sent Outreach Not Synced"
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "crm_master",
          "mode": "name"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        -400,
        16
      ],
      "id": "fb3ed389-7eb4-50de-a7d6-84d991ba79b8",
      "name": "Read CRM Master"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        0,
        0
      ],
      "id": "e28a266f-b883-5fc8-9794-e1105bbe533b",
      "name": "Merge Follow-ups and CRM"
    },
    {
      "parameters": {
        "jsCode": "const sentItems =\n  $('Select Sent Outreach Not Synced').all();\nconst crmRows = $('Read CRM Master').all();\n\nconst normalize = value =>\n  String(value || '').trim().toLowerCase();\n\nconst addDays = (dateValue, days) => {\n  const date = new Date(\n    `${String(dateValue).slice(0, 10)}T12:00:00`\n  );\n  if (Number.isNaN(date.getTime())) return '';\n  date.setDate(date.getDate() + days);\n  return date.toISOString().slice(0, 10);\n};\n\nconst deriveLeadId = row => {\n  const direct = String(row.lead_id || '').trim();\n  if (direct) return direct;\n  const match = String(row.draft_id || '').match(/lead_\\d+/i);\n  return match ? match[0].toLowerCase() : '';\n};\n\nconst results = [];\n\nfor (const sentItem of sentItems) {\n  const sent = sentItem.json;\n  const leadId = deriveLeadId(sent);\n  if (!leadId) continue;\n\n  const crmItem = crmRows.find(item =>\n    normalize(item.json.lead_id) === normalize(leadId)\n  );\n  if (!crmItem) continue;\n\n  const crm = crmItem.json;\n  const isFollowUp = normalize(sent.campaign_id)\n    .startsWith('example_outreach_followup');\n  const previousCount = Number(crm.follow_up_count || 0);\n  const newCount = isFollowUp\n    ? Math.min(previousCount + 1, 2)\n    : previousCount;\n  const sentDate = String(\n    sent.sent_at || new Date().toISOString()\n  ).slice(0, 10);\n\n  results.push({\n    json: {\n      ...crm,\n      lead_id: leadId,\n      follow_up_count: newCount,\n      outreach_status: isFollowUp\n        ? (newCount >= 2 ? 'Stopped' : 'Sent')\n        : 'Sent',\n      last_contact_date: sentDate,\n      next_action_date:\n        isFollowUp && newCount >= 2\n          ? ''\n          : addDays(sentDate, 5),\n      outreach_draft_id: sent.draft_id,\n      outreach_draft_row_number: sent.row_number,\n      original_outreach_notes: sent.notes || '',\n      crm_sync_timestamp: new Date().toISOString(),\n    },\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
