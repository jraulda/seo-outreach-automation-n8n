      "parameters": {
        "jsonSchemaExample": "{\n  \"service_fit_score\": 0,\n  \"commercial_potential_score\": 0,\n  \"recommended_service\": \"\",\n  \"secondary_service\": \"\",\n  \"qualification_reason\": \"\",\n  \"evidence\": [\"\"],\n  \"risk_flags\": [\"\"],\n  \"confidence\": \"Low\",\n  \"recommended_action\": \"Manual review\"\n}"
      },
