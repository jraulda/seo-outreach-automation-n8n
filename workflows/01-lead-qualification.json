      "id": "ccf199ee-049a-5368-8cdc-13c3b3b8141d",
      "name": "Fetch Company Website",
      "retryOnFail": false,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead =\n  $('Score and Select Pilot').item.json;\n\nconst html = String(\n  $json.data ||\n  $json.body ||\n  ''\n);\n\nconst getMatch = regex => {\n  const match = html.match(regex);\n  return match ? match[1].trim() : '';\n};\n\nconst title = getMatch(\n  /<title[^>]*>([\\s\\S]*?)<\\/title>/i\n);\n\nconst description =\n  getMatch(\n    /<meta[^>]+name=[\"']description[\"'][^>]+content=[\"']([^\"']*)[\"']/i\n  ) ||\n  getMatch(\n    /<meta[^>]+content=[\"']([^\"']*)[\"'][^>]+name=[\"']description[\"']/i\n  );\n\nconst cleanText = html\n  .replace(\n    /<(script|style|noscript|svg)[^>]*>[\\s\\S]*?<\\/\\1>/gi,\n    ' '\n  )\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/&nbsp;/gi, ' ')\n  .replace(/&amp;/gi, '&')\n  .replace(/&quot;/gi, '\"')\n  .replace(/&#39;/gi, \"'\")\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nreturn {\n  json: {\n    ...lead,\n    website_fetch_status: 'Fetched',\n    website_title: title,\n    website_description: description,\n    website_original_characters:\n      html.length,\n    website_text: cleanText.slice(0, 12000),\n    website_text_truncated:\n      cleanText.length > 12000,\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -944,
        96
      ],
      "id": "a48e2d2e-7bcb-5220-8668-03c0fae49c34",
      "name": "Extract Website Evidence"
    },
