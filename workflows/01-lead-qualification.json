      "id": "2da71dc0-2582-556c-a314-75971851d7b4",
      "name": "When clicking ‘Execute workflow’"
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nreturn rows.filter(item => {\n  const row = item.json;\n\n  const doNotContact =\n    row.do_not_contact === true ||\n    String(row.do_not_contact || '')\n      .trim()\n      .toLowerCase() === 'true';\n\n  const hasEmail =\n    String(row.primary_email || '').trim() !== '';\n\n  const hasWebsite =\n    String(row.website || '').trim() !== '';\n\n  const readyForScoring =\n    String(row.campaign_eligibility || '').trim() ===\n    'Ready for scoring';\n\n  const needsReview =\n    String(row.data_quality || '').trim() ===\n    'Review';\n\n  const alreadyScored =\n    String(row.lead_score ?? '').trim() !== '';\n\n  return (\n    readyForScoring &&\n    hasEmail &&\n    hasWebsite &&\n    !doNotContact &&\n    !needsReview &&\n    !alreadyScored\n  );\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1584,
        352
      ],
      "id": "35c879d1-678c-5e43-a812-a8b79c6b86b5",
      "name": "Filter Scoring Candidates"
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nconst publicDomains = new Set([\n  'gmail.com',\n  'hotmail.com',\n  'outlook.com',\n  'yahoo.com',\n  'live.com',\n  'icloud.com',\n]);\n\nconst cleanDomain = value =>\n  String(value || '')\n    .trim()\n    .toLowerCase()\n    .replace(/^www\\./, '');\n\nconst scored = rows.map(item => {\n  const row = item.json;\n\n  const emailDomain =\n    cleanDomain(row.email_domain) ||\n    cleanDomain(\n      String(row.primary_email || '').split('@')[1]\n    );\n\n  const websiteDomain =\n    cleanDomain(row.website_domain);\n\n  const businessDomainMatch =\n    emailDomain &&\n    websiteDomain &&\n    !publicDomains.has(emailDomain) &&\n    (\n      emailDomain === websiteDomain ||\n      emailDomain.endsWith(`.${websiteDomain}`) ||\n      websiteDomain.endsWith(`.${emailDomain}`)\n    );\n\n  let deterministicScore = 0;\n  const evidence = [];\n\n  if (businessDomainMatch) {\n    deterministicScore += 20;\n    evidence.push(\n      'Business email domain matches website'\n    );\n  }\n\n  if (String(row.contact_name || '').trim()) {\n    deterministicScore += 10;\n    evidence.push('Contact name available');\n  }\n\n  if (String(row.contact_phone || '').trim()) {\n    deterministicScore += 5;\n    evidence.push('Phone available');\n  }\n\n  if (String(row.website || '').trim()) {\n    deterministicScore += 10;\n    evidence.push('Website available');\n  }\n\n  if (String(row.source_segment || '').trim()) {\n    deterministicScore += 10;\n    evidence.push('Source context available');\n  }\n\n  return {\n    json: {\n      ...row,\n      deterministic_score: deterministicScore,\n      deterministic_evidence: evidence,\n      requires_ai_scoring: true,\n    },\n  };\n});\n\nscored.sort((a, b) => {\n  const scoreDifference =\n    b.json.deterministic_score -\n    a.json.deterministic_score;\n\n  if (scoreDifference !== 0) {\n    return scoreDifference;\n  }\n\n  return String(a.json.lead_id)\n    .localeCompare(String(b.json.lead_id));\n});\n\nreturn scored.slice(0, 10);"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
