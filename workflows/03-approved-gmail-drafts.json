      "id": "84006aba-d021-5f44-96e3-2cb99d6be29c",
      "name": "Update Outreach Draft Status"
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nreturn rows.filter(item => {\n  const row = item.json;\n\n  const approved =\n    String(row.draft_status || '').trim() ===\n    'Approved to draft';\n\n  const hasRecipient =\n    String(row.recipient_email || '').trim() !== '';\n\n  const hasSubject =\n    String(row.subject || '').trim() !== '';\n\n  const hasBody =\n    String(row.body || '').trim() !== '';\n\n  const notCreatedYet =\n    String(row.gmail_draft_id || '').trim() === '';\n\n  return (\n    approved &&\n    hasRecipient &&\n    hasSubject &&\n    hasBody &&\n    notCreatedYet\n  );\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
