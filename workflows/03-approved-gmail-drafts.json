    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const followUp = $('Gmail Draft — Five').item.json;\nconst message = $json;\n\nconst threadId = String(message.threadId || '').trim();\nconst messageId = String(message.id || '').trim();\n\nif (!threadId) {\n  throw new Error(\n    'The original Gmail thread was not found for ' +\n    String(followUp.recipient_email || '') +\n    '. A standalone draft was not created.'\n  );\n}\n\nreturn {\n  json: {\n    ...followUp,\n    original_gmail_message_id: messageId,\n    original_gmail_thread_id: threadId,\n  },\n};"
      },
      "id": "854d768a-b5a2-55a0-aaf9-96ef6e8f7041",
