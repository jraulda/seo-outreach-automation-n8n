    {
      "parameters": {
        "operation": "getAll",
        "limit": 1,
        "filters": {
          "q": "={{ (() => { const email = String($json.recipient_email || '').trim(); const subject = String($json.subject || '').replace(/^(\\s*re:\\s*)+/i, '').replace(/\\\"/g, ''); return `in:sent to:${email} subject:\"${subject}\"`; })() }}"
        }
      },
      "id": "08f5323f-d6a8-54eb-8c2b-85db65720d3b",
      "name": "Find Original Sent Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
