    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const originalDraft =\n  $('Gmail Draft — Five').item.json;\n\nconst gmailResult = $json;\n\nconst existingNotes =\n  String(originalDraft.notes || '').trim();\n\nconst messageId =\n  gmailResult.message?.id || '';\n\nconst threadId =\n  gmailResult.message?.threadId ||\n  gmailResult.threadId || '';\n\nconst notes = [\n  existingNotes,\n  messageId\n    ? `Gmail message ID: ${messageId}`\n    : '',\n  threadId\n    ? `Gmail thread ID: ${threadId}`\n    : '',\n]\n  .filter(Boolean)\n  .join(' | ');\n\nreturn {\n  json: {\n    ...originalDraft,\n\n    draft_status:\n      'Gmail draft created',\n\n    gmail_draft_id:\n      gmailResult.id || '',\n\n    notes,\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
